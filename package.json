{
  "name": "kadena-monorepo",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k -n WEB,CMS -c cyan,magenta \"npm run dev --workspace=apps/web\" \"npm run develop --workspace=apps/cms\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:cms": "npm run develop --workspace=apps/cms",
    "build:web": "npm run build --workspace=apps/web",
    "build:cms": "npm run build --workspace=apps/cms"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
